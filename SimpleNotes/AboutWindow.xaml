<Window x:Class="SimpleNotes.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre"
        Height="350"
        Width="400"
        Icon="/Assets/icone.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" HorizontalAlignment="Center">

        <!-- Imagem do aplicativo -->
        <Image Source="/Assets/icone.ico"
               Width="80"
               Height="80"
               Margin="0,0,0,10"/>

        <!-- Nome -->
        <TextBlock Text="Simpe Notes"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Versão 1.0.0"
                   Foreground="Gray"
                   Margin="0,5,0,10"/>

        <!-- Descrição -->
        <TextBlock Text="Um simples app de bloco de notas feito com intuido de estuadar o C# e WPF"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- GitHub -->
        <TextBlock HorizontalAlignment="Center">
            <Hyperlink NavigateUri="https://github.com/hiagosso/SimpleNotesApp/"
                       RequestNavigate="Hyperlink_RequestNavigate">
                Ver projeto no GitHub
            </Hyperlink>
        </TextBlock>

    </StackPanel>
</Window>