<Window x:Class="SimpleNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/icone.ico"
        Title="Simple Notes"
        Height="600"
        Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Linha do menu -->
            
            <RowDefinition Height="Auto"/>

            <!-- Área de edição -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu superior -->
        <Menu Grid.Row="0"
              HorizontalAlignment="Stretch">

            <MenuItem Header="Arquivo">
                <MenuItem Header="Novo" Name="newFileBtn"/>
                <MenuItem Header="Abrir" Name="openFileBtn"/>
                <MenuItem Header="Salvar" Name="saveFileBtn"/>
                <MenuItem Header="Salvar Como" Name="saveAsFileBtn"/>

                <Separator/>

                <MenuItem Header="Sair"
                          Name="exitBtn"
                          Click="exitBtn_Click"/>
            </MenuItem>

            <MenuItem Header="Ajuda" >
                <MenuItem Header="Sobre" Name="aboutBtn" Click="aboutBtn_Click" />
            </MenuItem>

        </Menu>

        <!-- Área de texto -->
        <TextBox Grid.Row="1"
                 Name="textArea"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Padding="10"/>

    </Grid>

</Window>