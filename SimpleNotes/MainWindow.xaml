<Window x:Class="SimpleNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/icone.ico"
        Title="Simple Notes"
        Height="600"
        Width="800"
        MinHeight="400"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu principal -->
        <Menu Grid.Row="0">

            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo"
              Click="newFileBtn_Click"
              InputGestureText="Ctrl+N"/>

                <MenuItem Header="_Abrir"
              Click="openFileBtn_Click"
              InputGestureText="Ctrl+O"/>

                <Separator/>

                <MenuItem Header="_Salvar"
              Click="saveFileBtn_Click"
              InputGestureText="Ctrl+S"/>

                <MenuItem Header="Salvar _como..."
              Click="SaveFileAsBtn_Click"
              InputGestureText="Ctrl+Shift+S"/>

                <Separator/>

                <MenuItem Header="_Sair"
              Click="exitBtn_Click"
              InputGestureText="Esc"/>
            </MenuItem>

            <MenuItem Header="_Ajuda">
                <MenuItem Header="_Sobre" Click="aboutBtn_Click"></MenuItem>                
            </MenuItem>

        </Menu>

        <!-- Área de edição -->
        <TextBox Grid.Row="1"
                 Name="textArea"
                 FontSize="20"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Padding="10"
                 TextChanged="textArea_TextChanged"
                 PreviewMouseWheel="TextArea_PreviewMouseWheel"/>

        <!-- Barra de status -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="StatusMessage"
                           Text="Pronto"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Name="ZoomIndicator"
                           Text="Zoom: 20"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
