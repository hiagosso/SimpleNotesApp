<Window x:Class="SimpleNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/icone.ico"
        Title="Simple Notes"
        Height="600"
        Width="800"
        MinHeight="400"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu principal -->
        <Menu Grid.Row="0">

            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo"
                          Name="newFileBtn"
                          Click="newFileBtn_Click"/>

                <MenuItem Header="_Abrir"
                          Name="openFileBtn"
                          Click="openFileBtn_Click"/>

                <MenuItem Header="_Salvar"
                          Name="saveFileBtn"
                          Click="saveFileBtn_Click"/>

                <MenuItem Header="Salvar _Como"
                          Name="saveAsFileBtn"
                          Click="SaveFileAsBtn_Click"/>

                <Separator/>

                <MenuItem Header="_Sair"
                          Name="exitBtn"
                          Click="exitBtn_Click"/>
            </MenuItem>

            <MenuItem Header="_Ajuda">
                <MenuItem Header="_Sobre"
                          Name="aboutBtn"
                          Click="aboutBtn_Click"/>
            </MenuItem>

        </Menu>

        <!-- Área de edição -->
        <TextBox Grid.Row="1"
                 Name="textArea"
                 FontSize="20"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Padding="10"
                 TextChanged="textArea_TextChanged"
                 PreviewMouseWheel="TextArea_PreviewMouseWheel"/>

        <!-- Barra de status -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="StatusMessage"
                           Text="Pronto"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Name="ZoomIndicator"
                           Text="Zoom: 20"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
